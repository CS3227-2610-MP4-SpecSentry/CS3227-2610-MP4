generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AccountRole {
  CONTRIBUTOR
  REVIEWER
  RELEASE_MAINTAINER
}

model UserAccount {
  id           String      @id @default(uuid())
  username     String      @unique
  passwordHash String
  role         AccountRole
  enabled      Boolean     @default(true)
  version      Int         @default(1)
  proposals    ChangeProposal[]
  assignments  ReviewAssignment[]
  activities   ProposalActivity[]
  coverage CoverageAssessment[]
  findings ReviewFinding[]
  findingEvents FindingEvent[]
  decisions ReviewDecision[]
  reviewIdempotency ReviewIdempotency[]
  createdReleaseCandidates ReleaseCandidate[]
  releaseSmokeTests ReleaseSmokeTest[]
  releasePublications ReleasePublicationSnapshot[]
}

model AuthSession {
  id        String   @id
  data      String
  expiresAt DateTime

  @@index([expiresAt])
}

model LoginThrottle {
  key          String   @id
  failuresAt   DateTime[]
  updatedAt    DateTime @updatedAt
  blockedUntil DateTime?
}

// Restricted operational evidence, never exposed as submission activity.
model SecurityEvent {
  id            String   @id @default(uuid())
  actorId       String?
  action        String
  target        String
  outcome       String
  correlationId String?
  timestamp     DateTime @default(now())

  @@index([timestamp])
}

enum ProposalState {
  DRAFT
  SUBMITTED
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  IN_RELEASE
  RELEASED
  WITHDRAWN
}

enum ReviewAssignmentStatus {
  ACTIVE
  CLOSED
}

enum AssignmentEndReason {
  DROPPED
  ACCOUNT_DISABLED
  REVISION_REPLACED
  WITHDRAWN
}

enum ProposalActivityAction {
  DRAFT_CREATED
  DRAFT_SAVED
  WITHDRAWN
  REOPENED
  NOTIFICATION_CREATED
  SUBMITTED
  RESUBMITTED
  CLAIMED
  DROPPED
  ASSIGNMENT_RELEASED
  COVERAGE_ASSESSED
  COVERAGE_CONFIRMED
  FINDING_CREATED
  FINDING_TRANSITIONED
  FINDING_AMENDED
  REVIEW_APPROVED
  CHANGES_REQUESTED
  APPROVAL_REVOKED
  RELEASE_ATTACHED
  RELEASE_REMOVED
  RELEASE_PUBLISHED
}

// Lifecycle root. Composite foreign keys prevent cross-proposal pointers.
model ChangeProposal {
  id                  String            @id @default(uuid())
  ownerId             String
  title               String
  state               ProposalState     @default(DRAFT)
  currentRevisionId   String?
  currentAssignmentId String?           @unique
  firstSubmittedAt    DateTime?
  createdAt           DateTime          @default(now())
  version             Int               @default(0)
  releaseAttachmentRef String?
  owner               UserAccount       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  revisions           ProposalRevision[] @relation("ProposalRevisions")
  currentRevision     ProposalRevision? @relation("CurrentRevision", fields: [id, currentRevisionId], references: [proposalId, id], onDelete: Restrict, onUpdate: NoAction)
  assignments         ReviewAssignment[] @relation("ProposalAssignments")
  currentAssignment   ReviewAssignment? @relation("CurrentAssignment", fields: [id, currentRevisionId, currentAssignmentId], references: [proposalId, revisionId, id], onDelete: Restrict, onUpdate: NoAction)
  activities          ProposalActivity[]
  coverage CoverageAssessment[]
  findings ReviewFinding[]
  decisions ReviewDecision[]
  reviewIdempotency ReviewIdempotency[]
  releaseMembers ReleaseCandidateMember[]

  @@index([state, firstSubmittedAt, id])
  @@index([ownerId])
  @@unique([id, currentRevisionId, currentAssignmentId])
}

// Every row is a submitted snapshot; no draft/private fields live here.
model ProposalRevision {
  id               String                @id @default(uuid())
  proposalId       String
  number           Int
  summary          String
  problem          String
  constraints      String
  expectedBehavior String
  diffText         String
  submittedAt      DateTime              @default(now())
  createdAt        DateTime              @default(now())
  proposal         ChangeProposal        @relation("ProposalRevisions", fields: [proposalId], references: [id], onDelete: Restrict)
  currentFor       ChangeProposal[]      @relation("CurrentRevision")
  criteria         AcceptanceCriterion[]
  evidence         TestEvidence[]
  assignments      ReviewAssignment[]
  activities       ProposalActivity[]
  releaseMembers ReleaseCandidateMember[]

  @@unique([proposalId, id])
  @@unique([proposalId, number])
  @@index([proposalId, number(sort: Desc), id])
}

model AcceptanceCriterion {
  id            String                  @id @default(uuid())
  revisionId    String
  stableKey     String
  statement     String
  required      Boolean                 @default(true)
  revision      ProposalRevision        @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  evidenceLinks CriterionEvidenceLink[]
  coverage CoverageAssessment[]
  findings ReviewFinding[]

  @@unique([revisionId, id])
  @@unique([revisionId, stableKey])
}

model TestEvidence {
  id             String                  @id @default(uuid())
  revisionId     String
  text           String
  evidenceHash   String
  revision       ProposalRevision        @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  criterionLinks CriterionEvidenceLink[]
  coverageLinks CoverageEvidence[]

  @@unique([revisionId, id])
}

model CriterionEvidenceLink {
  revisionId  String
  criterionId String
  evidenceId  String
  criterion   AcceptanceCriterion @relation(fields: [revisionId, criterionId], references: [revisionId, id], onDelete: Restrict)
  evidence    TestEvidence        @relation(fields: [revisionId, evidenceId], references: [revisionId, id], onDelete: Restrict)

  @@id([criterionId, evidenceId])
}

// Closing an assignment retains its identity and provenance permanently.
model ReviewAssignment {
  id           String                 @id @default(uuid())
  // Immutable continuity identity, copied only for retained-reviewer revisions.
  accessGenerationId String           @default(dbgenerated("gen_random_uuid()::text"))
  proposalId   String
  revisionId   String
  reviewerId   String
  status       ReviewAssignmentStatus @default(ACTIVE)
  assignedAt   DateTime               @default(now())
  endedAt      DateTime?
  endReason    AssignmentEndReason?
  version      Int                    @default(0)
  proposal     ChangeProposal         @relation("ProposalAssignments", fields: [proposalId], references: [id], onDelete: Restrict)
  revision     ProposalRevision       @relation(fields: [proposalId, revisionId], references: [proposalId, id], onDelete: Restrict)
  reviewer     UserAccount            @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  currentFor   ChangeProposal?        @relation("CurrentAssignment")
  activities   ProposalActivity[]
  coverage CoverageAssessment[]
  findings ReviewFinding[]
  findingEvents FindingEvent[]
  decisions ReviewDecision[]
  releaseMembers ReleaseCandidateMember[]


  @@unique([proposalId, revisionId, id])
  @@index([reviewerId, status, assignedAt, id])
  @@index([proposalId, assignedAt, id])
  @@index([proposalId, reviewerId, accessGenerationId])
}

// Separate from operational security events and their retention/pruning policy.
model ProposalActivity {
  id           String                 @id @default(uuid())
  proposalId   String
  revisionId   String?
  assignmentId String?
  actorId      String?
  candidateId  String?
  action       ProposalActivityAction
  outcome      String                 @default("SUCCESS")
  summary      String
  reason       String?
  timestamp    DateTime               @default(now())
  proposal     ChangeProposal         @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  revision     ProposalRevision?      @relation(fields: [proposalId, revisionId], references: [proposalId, id], onDelete: Restrict)
  assignment   ReviewAssignment?      @relation(fields: [proposalId, revisionId, assignmentId], references: [proposalId, revisionId, id], onDelete: Restrict)
  actor        UserAccount?           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  candidate    ReleaseCandidate?      @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  @@index([proposalId, timestamp, id])
}

// Private working content; never selected by submitted-review projections.
model WorkingRevision {
  id String @id @default(uuid())
  proposalId String @unique
  content Json
  updatedAt DateTime @updatedAt
}

enum NotificationKind {
  NEW_REVISION
  WITHDRAWN
  APPROVAL_REVOKED
}

model Notification {
  id String @id @default(uuid())
  recipientId String
  kind NotificationKind
  proposalId String
  revisionId String
  assignmentId String
  activityId String @unique
  candidateId String?
  invalidationId String? @unique
  reviewerId String?
  reason String?
  createdAt DateTime @default(now())
  readAt DateTime?
  candidate ReleaseCandidate? @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  invalidation ApprovalInvalidation? @relation(fields: [invalidationId], references: [id], onDelete: Restrict)
  @@index([recipientId, createdAt, id])
}

enum ApprovalInvalidationCause {
  REOPENED
  REVOKED
}

model ApprovalInvalidation {
  id String @id @default(uuid())
  proposalId String
  revisionId String
  assignmentId String
  decisionId String @unique
  actorId String
  mutationVersion Int
  cause ApprovalInvalidationCause @default(REOPENED)
  reason String?
  candidateId String?
  createdAt DateTime @default(now())
  candidate ReleaseCandidate? @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  notifications Notification[]
  @@unique([proposalId, mutationVersion])
}

enum ReleaseCandidateStatus {
  OPEN
  RELEASED
}

enum ReleaseMemberStatus {
  ATTACHED
  REMOVED
  RELEASED
}

enum ReleaseSmokeOutcome {
  PASS
  FAIL
}

model ReleaseCandidate {
  id String @id @default(uuid())
  projectKey String
  semanticVersion String
  createdById String
  status ReleaseCandidateStatus @default(OPEN)
  version Int @default(0)
  contentVersion Int @default(0)
  rollbackPlan String
  dependencyNotes String
  createdAt DateTime @default(now())
  publishedAt DateTime?
  createdBy UserAccount @relation(fields: [createdById], references: [id], onDelete: Restrict)
  members ReleaseCandidateMember[]
  smokeTests ReleaseSmokeTest[]
  publication ReleasePublicationSnapshot?
  invalidations ApprovalInvalidation[]
  notifications Notification[]
  activities ProposalActivity[]
  @@unique([projectKey, semanticVersion])
  @@index([createdById, status, createdAt, id])
}

model ReleaseCandidateMember {
  id String @id @default(uuid())
  candidateId String
  proposalId String
  revisionId String
  assignmentId String
  approvalId String
  status ReleaseMemberStatus @default(ATTACHED)
  attachedAt DateTime @default(now())
  removedAt DateTime?
  candidate ReleaseCandidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  proposal ChangeProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  revision ProposalRevision @relation(fields: [proposalId, revisionId], references: [proposalId, id], onDelete: Restrict)
  assignment ReviewAssignment @relation(fields: [proposalId, revisionId, assignmentId], references: [proposalId, revisionId, id], onDelete: Restrict)
  approval ReviewDecision @relation(fields: [proposalId, revisionId, assignmentId, approvalId], references: [proposalId, revisionId, assignmentId, id], onDelete: Restrict)
  @@index([candidateId, status, proposalId])
  @@index([proposalId, status])
}

model ReleaseSmokeTest {
  id String @id @default(uuid())
  candidateId String
  testedContentVersion Int
  outcome ReleaseSmokeOutcome
  procedure String
  results String
  actorId String
  createdAt DateTime @default(now())
  candidate ReleaseCandidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  actor UserAccount @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([candidateId, testedContentVersion, createdAt, id], map: "ReleaseSmokeTest_candidate_content_time_idx")
}

model ReleasePublicationSnapshot {
  id String @id @default(uuid())
  candidateId String @unique
  actorId String
  candidateVersion Int
  contentVersion Int
  evidence Json
  createdAt DateTime @default(now())
  candidate ReleaseCandidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  actor UserAccount @relation(fields: [actorId], references: [id], onDelete: Restrict)
}

enum CoverageStatus {
  COVERED
  PARTIALLY_COVERED
  NOT_COVERED
  NOT_APPLICABLE
}
enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum FindingStatus {
  OPEN
  RESOLVED
}
enum FindingOperation {
  RESOLVE
  REOPEN
  CHANGE_SEVERITY
  AMEND
}
enum ReviewDecisionKind {
  APPROVE
  REQUEST_CHANGES
}
model CoverageAssessment {
  id String @id @default(uuid())
  proposalId String
  revisionId String
  assignmentId String
  criterionId String
  actorId String
  status CoverageStatus
  rationale String?
  sourceCoverageId String?
  mutationVersion Int
  createdAt DateTime @default(now())
  proposal ChangeProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  assignment ReviewAssignment @relation(fields: [proposalId, revisionId, assignmentId], references: [proposalId, revisionId, id], onDelete: Restrict)
  criterion AcceptanceCriterion @relation(fields: [revisionId, criterionId], references: [revisionId, id], onDelete: Restrict)
  actor UserAccount @relation(fields: [actorId], references: [id], onDelete: Restrict)
  source CoverageAssessment? @relation("CoverageConfirmation", fields: [proposalId, revisionId, criterionId, sourceCoverageId], references: [proposalId, revisionId, criterionId, id], onDelete: Restrict, onUpdate: NoAction)
  confirmations CoverageAssessment[] @relation("CoverageConfirmation")
  evidence CoverageEvidence[]
  @@unique([proposalId, mutationVersion])
  @@unique([proposalId, revisionId, criterionId, id])
  @@unique([revisionId, id])
  @@index([proposalId, revisionId, criterionId, mutationVersion])
}
model CoverageEvidence {
  assessmentId String
  revisionId String
  evidenceId String
  assessment CoverageAssessment @relation(fields: [revisionId, assessmentId], references: [revisionId, id], onDelete: Restrict)
  evidence TestEvidence @relation(fields: [revisionId, evidenceId], references: [revisionId, id], onDelete: Restrict)
  @@id([assessmentId, evidenceId])
}
model ReviewFinding {
  id String @id @default(uuid())
  proposalId String
  revisionId String
  assignmentId String
  actorId String
  criterionId String?
  diffLocation Json?
  severity FindingSeverity
  description String
  mutationVersion Int
  createdAt DateTime @default(now())
  proposal ChangeProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  assignment ReviewAssignment @relation(fields: [proposalId, revisionId, assignmentId], references: [proposalId, revisionId, id], onDelete: Restrict)
  criterion AcceptanceCriterion? @relation(fields: [revisionId, criterionId], references: [revisionId, id], onDelete: Restrict)
  actor UserAccount @relation(fields: [actorId], references: [id], onDelete: Restrict)
  events FindingEvent[]
  @@unique([proposalId, id])
  @@unique([proposalId, mutationVersion])
  @@index([proposalId, mutationVersion, id])
}
model FindingEvent {
  id String @id @default(uuid())
  findingId String
  proposalId String
  revisionId String
  assignmentId String
  actorId String
  operation FindingOperation
  reason String
  description String?
  severity FindingSeverity
  status FindingStatus
  mutationVersion Int
  createdAt DateTime @default(now())
  finding ReviewFinding @relation(fields: [proposalId, findingId], references: [proposalId, id], onDelete: Restrict)
  assignment ReviewAssignment @relation(fields: [proposalId, revisionId, assignmentId], references: [proposalId, revisionId, id], onDelete: Restrict)
  actor UserAccount @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([proposalId, mutationVersion])
  @@index([proposalId, findingId, mutationVersion, id])
}
model ReviewDecision {
  id String @id @default(uuid())
  proposalId String
  revisionId String
  assignmentId String
  actorId String
  decision ReviewDecisionKind
  note String?
  mutationVersion Int
  createdAt DateTime @default(now())
  proposal ChangeProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  assignment ReviewAssignment @relation(fields: [proposalId, revisionId, assignmentId], references: [proposalId, revisionId, id], onDelete: Restrict)
  actor UserAccount @relation(fields: [actorId], references: [id], onDelete: Restrict)
  releaseMembers ReleaseCandidateMember[]
  @@unique([proposalId, revisionId])
  @@unique([proposalId, revisionId, assignmentId, id], map: "ReviewDecision_exact_release_approval_key")
  @@unique([proposalId, mutationVersion])
  @@index([proposalId, mutationVersion, id])
}
model ReviewIdempotency {
  id String @id @default(uuid())
  proposalId String
  actorId String
  operation String
  keyHash String
  requestHash String
  response Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  proposal ChangeProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  actor UserAccount @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([actorId, operation, proposalId, keyHash])
  @@index([expiresAt])
}

// AI operational evidence deliberately has no business foreign keys and no
// recoverable submitted/provider text. Business fixture cleanup cannot erase it.
enum AiOutcome {
  SUCCESS
  STALE
  REJECTED
  FAILED
  CANCELLED
}
enum AiErrorClass {
  DISABLED
  CONFIGURATION
  INPUT_LIMIT
  SECRET_DETECTED
  UNSUPPORTED_INPUT
  ACCESS_LOST
  SCOPE_CHANGED
  DEADLINE
  RATE_LIMIT
  QUEUE_FULL
  PROVIDER_AUTH
  PROVIDER_REQUEST
  PROVIDER_QUOTA
  PROVIDER_TRANSIENT
  TRANSPORT
  INVALID_OUTPUT
  CANCELLED
  INTERNAL
}
model AiRequest {
  id String @id @default(uuid())
  correlationId String
  actorId String
  proposalId String
  revisionId String
  assignmentId String
  accessGenerationId String
  expectedVersion Int
  expectedAssignmentVersion Int
  selectedCriterionCount Int
  templateVersion String
  contextHash String?
  requestedAt DateTime @default(now())
  completedAt DateTime?
  latencyMs Int?
  outcome AiOutcome?
  errorClass AiErrorClass?
  retainedUntil DateTime @default(dbgenerated("(CURRENT_TIMESTAMP + '90 days'::interval)"))
  attempts AiOutboundAttempt[]
  @@index([actorId, proposalId, requestedAt, id])
  @@index([retainedUntil])
}
model AiOutboundAttempt {
  id String @id @default(uuid())
  requestId String
  actorId String
  ordinal Int
  dispatchedAt DateTime @default(now())
  completedAt DateTime?
  latencyMs Int?
  outcome AiOutcome?
  errorClass AiErrorClass?
  promptTokens Int?
  completionTokens Int?
  totalTokens Int?
  cachedTokens Int?
  request AiRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  @@unique([requestId, ordinal])
  @@index([actorId, dispatchedAt])
  @@index([dispatchedAt])
}
// Waiting slots are distinct from dispatch reservations/usage. Expired rows can
// be reclaimed atomically under the coordinator without business-root locks.
model AiQueueLease {
  id String @id @default(uuid())
  requestId String @unique
  actorId String
  enqueuedAt DateTime @default(now())
  expiresAt DateTime
  @@index([expiresAt, enqueuedAt, id])
}
model AiQuotaCoordinator {
  id String @id
  // Durable single-row serialization point across all application processes.
  updatedAt DateTime @default(now()) @updatedAt
}



