{
  "id": "revocation-browser",
  "kind": "browser",
  "argv": [
    "C:/Users/User/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node.exe",
    "node_modules/@playwright/test/cli.js",
    "test",
    "workflow/tests/browser/reviewer-revocation.spec.ts",
    "--grep",
    "revoke-ui|revoke-ui-recovery|revoke-ui-accessibility",
    "--workers=1"
  ],
  "paths": [
    "package.json",
    "package-lock.json",
    "src/shared/src",
    "src/server/src/identity",
    "src/server/src/proposals",
    "src/server/src/activity",
    "src/server/prisma",
    "src/server/test/business-fixtures.ts",
    "src/server/package.json",
    "src/server/jest.integration.config.cjs",
    "src/client/src",
    "src/server/src",
    "workflow/tests/browser",
    "playwright.config.ts"
  ],
  "depends_on": [
    "runtime"
  ],
  "resources": [
    "build",
    "database"
  ],
  "environment": [
    "TEST_DATABASE_URL"
  ],
  "database": {
    "environment": "TEST_DATABASE_URL",
    "name": "specsentry_reviewer_intake_test"
  },
  "timeout": 180
}
