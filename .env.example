# Local synthetic credentials only. Copy to .env; never commit live connection strings.
NODE_ENV=development
PORT=3000
# Generate an independent random secret per environment (at least 32 characters).
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Leave zero locally; set only for a known reverse proxy topology.
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://specsentry:specsentry_local@localhost:5432/specsentry
# Neon writes the direct URL under this name when it creates .env.local.
DATABASE_URL_UNPOOLED=postgresql://specsentry:specsentry_local@localhost:5432/specsentry
# Protected deployment environments may supply the same direct URL under this name.
DIRECT_DATABASE_URL=postgresql://specsentry:specsentry_local@localhost:5432/specsentry

# Safe local default. Render explicitly enables live AI with protected service secrets.
AI_LIVE_ENABLED=false
AI_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
# Supply the rotated key only in local environment/secrets, never commit it.
# AI_API_KEY=
AI_MODEL=default
AI_CONTEXT_WINDOW=262144
